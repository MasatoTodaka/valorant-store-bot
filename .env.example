# Discord Developer Portal (https://discord.com/developers/applications) で
# Botを作成し、Bot タブから取得したトークンを設定する
DISCORD_BOT_TOKEN=

# 開発中はテスト用サーバーのIDを指定するとスラッシュコマンドが即座に反映される
# (未設定の場合はグローバル反映まで最大1時間程度かかる)
DISCORD_GUILD_ID=

# Riotの認証情報は不要。Riot Client(ランチャー)にログインしていれば
# そのローカルセッションを自動的に読み取るため、.envへの保存は発生しない。
